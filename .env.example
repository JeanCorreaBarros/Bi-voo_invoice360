# Variables opcionales para `docker compose up`. Copia este archivo a ".env"
# en la raíz (docker compose lo lee automáticamente) y define valores propios
# si no quieres usar los defaults de desarrollo definidos en docker-compose.yml.
#
# Generar JWT_SECRET:    node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Generar ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_SECRET=
ENCRYPTION_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
