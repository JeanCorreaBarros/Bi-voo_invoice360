# URL base del backend (apps/api). Se usa en el navegador, asi que se
# "hornea" dentro del bundle en build time: si cambia, hay que rebuildear.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/

NEXT_PUBLIC_AUTH_REDIRECT=/login
NEXT_PUBLIC_APP_NAME=PlasticosLC
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@plasticoslc.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_ENVIRONMENT=development
