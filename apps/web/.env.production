# Next.js carga este archivo ENCIMA de .env solo cuando corre en modo
# produccion (next build / next start) - next dev lo ignora y usa .env
# (localhost) tal cual. Asi el mismo repo sirve para desarrollo local y
# para el build de Docker sin tocar nada a mano.
NEXT_PUBLIC_API_URL=https://backend-apibi360.cvwjsp.easypanel.host/api/
NEXT_PUBLIC_ENVIRONMENT=production
