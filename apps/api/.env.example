# BD de control-plane (registro de empresas y cuentas de plataforma)
PLATFORM_DATABASE_URL="postgresql://usuario:password@host:5432/plasticoslc_platform?schema=public"

# BD de tenant usada para desarrollo/autoria de migraciones del schema tenant.
# En produccion cada empresa usa su propia BD, creada dinamicamente por lib/db.js.
DATABASE_URL="postgresql://usuario:password@host:5432/plasticoslc?schema=public"

# Datos de conexion reutilizados por lib/db.js para construir la URL de cada
# BD de tenant (una BD fisica por empresa, mismo host/usuario/password).
TENANT_DB_HOST="host"
TENANT_DB_PORT="5432"
TENANT_DB_USER="usuario"
TENANT_DB_PASSWORD="password"

# Conexion con privilegios de administrador (CREATE DATABASE / DROP DATABASE).
# Se usa solo para provisionar/eliminar bases de datos de tenant.
POSTGRES_ADMIN_URL="postgresql://usuario:password@host:5432/postgres"

# Secreto para firmar JWT. Debe ser un valor aleatorio largo en produccion.
JWT_SECRET="cambia-este-valor-en-produccion"

PORT=3000

# Clave AES-256 en base64 (32 bytes) usada por lib/crypto.js para cifrar
# secretos guardados en BD (ej. API keys de integraciones de IA por empresa).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="genera-una-clave-real-de-32-bytes-en-base64"
